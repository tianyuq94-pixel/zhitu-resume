# 复制为 .env 后填写真实值。不要提交真实密码或 API Key。
AI_CAREER_APP_ENV=production
AI_CAREER_CORS_ORIGINS=["https://resume.example.com"]
AI_CAREER_ALLOWED_HOSTS=["resume.example.com"]

AI_CAREER_DB_HOST=127.0.0.1
AI_CAREER_DB_PORT=3306
AI_CAREER_DB_NAME=ai_career
AI_CAREER_DB_USER=ai_career
AI_CAREER_DB_PASSWORD=replace-with-a-strong-database-password

AI_CAREER_AUTH_SECRET=replace-with-at-least-32-cryptographically-random-characters
AI_CAREER_SECURE_COOKIES=true
AI_CAREER_AUTH_TOKEN_MINUTES=10080

AI_CAREER_STORAGE_ROOT=/var/lib/zhitu-resume/resumes
AI_CAREER_RESUME_MAX_BYTES=10485760
AI_CAREER_RESUME_PHOTO_MAX_BYTES=2097152

AI_CAREER_DEEPSEEK_API_KEY=replace-with-your-private-api-key
AI_CAREER_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CAREER_DEEPSEEK_MODEL=deepseek-v4-flash
AI_CAREER_DEEPSEEK_TIMEOUT_SECONDS=60
