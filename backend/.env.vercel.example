# 这些值在 Vercel 项目的 Environment Variables 中填写，不要提交真实密钥。
AI_CAREER_APP_ENV=production
AI_CAREER_CORS_ORIGINS=["https://zhitu-resume.vercel.app"]
AI_CAREER_ALLOWED_HOSTS=["*.vercel.app"]

# 使用 TiDB Cloud 控制台提供的 SQLAlchemy/MySQL 连接地址。
AI_CAREER_DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/DB_NAME?ssl_verify_cert=true&ssl_verify_identity=true
AI_CAREER_AUTO_CREATE_SCHEMA=true

AI_CAREER_AUTH_SECRET=replace-with-at-least-32-random-characters
AI_CAREER_SECURE_COOKIES=true
AI_CAREER_AUTH_TOKEN_MINUTES=10080

# 首次部署可先用 local；连接私有 Vercel Blob 后改为 vercel_blob。
AI_CAREER_STORAGE_BACKEND=local
AI_CAREER_RESUME_MAX_BYTES=4000000
AI_CAREER_RESUME_PHOTO_MAX_BYTES=2000000

AI_CAREER_DEEPSEEK_API_KEY=replace-with-your-private-api-key
AI_CAREER_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CAREER_DEEPSEEK_MODEL=deepseek-v4-flash
AI_CAREER_DEEPSEEK_TIMEOUT_SECONDS=60
