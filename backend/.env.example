AI_CAREER_APP_ENV=development
AI_CAREER_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
AI_CAREER_ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
AI_CAREER_DB_HOST=127.0.0.1
AI_CAREER_DB_PORT=3306
AI_CAREER_DB_NAME=ai_career
AI_CAREER_DB_USER=ai_career
AI_CAREER_DB_PASSWORD=replace-with-your-local-password
AI_CAREER_AUTH_SECRET=replace-with-at-least-32-random-characters
AI_CAREER_SECURE_COOKIES=false
AI_CAREER_RESUME_MAX_BYTES=10485760
AI_CAREER_DEEPSEEK_API_KEY=
AI_CAREER_DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_CAREER_DEEPSEEK_MODEL=deepseek-v4-flash
AI_CAREER_DEEPSEEK_TIMEOUT_SECONDS=60
